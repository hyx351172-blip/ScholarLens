# ScholarLens backend configuration
# Copy this file to .env and fill in the required API keys.

# Generation / vision-language model (OpenAI-compatible endpoint)
API_KEY=
MODEL_NAME=qwen3-vl-plus
MODEL_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding model
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings

# Optional reranker (currently disabled by default in the frontend)
RERANKER_API_KEY=
RERANKER_MODEL=gte-rerank-v2
RERANKER_URL=https://dashscope.aliyuncs.com

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Service addresses and ports
INFOR_EXTRAC_SERVICE_HOST=0.0.0.0
INFOR_EXTRAC_SERVICE_PORT=8006
CHUNK_SERVICE_HOST=0.0.0.0
CHUNK_SERVICE_PORT=8001
CHUNKING_SERVICE_ENABLED=true
MILVUS_API_HOST=0.0.0.0
MILVUS_API_PORT=8000
MILVUS_API_ENABLED=true
CHAT_SERVICE_HOST=0.0.0.0
CHAT_SERVICE_PORT=8501

# Upload limits
MAX_FILE_SIZE_MB=50

# Optional path overrides. Leave commented to use repository-local defaults.
# UPLOAD_BASE_DIR=C:/absolute/path/to/uploads
# EXTRACTION_RESULTS_DIR=C:/absolute/path/to/extraction_results
